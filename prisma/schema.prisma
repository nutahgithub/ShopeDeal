generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum PriceAlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
  CANCELLED
}

enum SaleEventStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  imageUrl       String?          @db.VarChar(2048)
  watchlistItems WatchlistItem[]
  priceAlerts    PriceAlert[]
  affiliateClicks AffiliateClick[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Shop {
  id             String    @id @default(cuid())
  externalId     String?   @unique
  name           String
  rating         Float?
  followerCount  Int?
  productCount   Int?
  isPreferred    Boolean   @default(false)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id              String           @id @default(cuid())
  externalId      String?          @unique
  shopeeItemId    String?          @unique
  name            String
  slug            String?
  description     String?          @db.Text
  imageUrl        String?          @db.VarChar(2048)
  productUrl      String           @db.VarChar(2048)
  affiliateUrl    String?          @db.VarChar(2048)
  currentPrice    Int
  originalPrice   Int?
  currency        String           @default("VND")
  rating          Float?
  reviewCount     Int              @default(0)
  soldCount       Int              @default(0)
  voucherLabel    String?
  shopId          String
  shop            Shop             @relation(fields: [shopId], references: [id])
  priceHistory    PriceHistory[]
  watchlistItems  WatchlistItem[]
  priceAlerts     PriceAlert[]
  affiliateClicks AffiliateClick[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([name])
  @@index([shopId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  price     Int
  currency  String   @default("VND")
  checkedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([productId, checkedAt])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model PriceAlert {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  productId   String
  product     Product          @relation(fields: [productId], references: [id])
  targetPrice Int
  status      PriceAlertStatus @default(ACTIVE)
  triggeredAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model AffiliateClick {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productUrl   String   @db.VarChar(2048)
  affiliateUrl String   @db.VarChar(2048)
  referrer    String?
  userAgent   String?  @db.Text
  ipAddress   String?
  clickedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([productId])
  @@index([clickedAt])
}

model SaleEvent {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?         @db.Text
  startsAt    DateTime
  endsAt      DateTime
  status      SaleEventStatus @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([startsAt, endsAt])
}
